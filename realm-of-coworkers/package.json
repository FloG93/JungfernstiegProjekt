{
  "name": "realm-of-coworkers",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "balance": "python3 tools/validate_content.py && python3 tools/crosscheck_balance.py && pnpm --filter @aethra/balance start",
    "content:check": "python3 tools/validate_content.py && python3 tools/crosscheck_balance.py",
    "admin": "pnpm --filter @aethra/server admin"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "@node-rs/argon2"]
  }
}
